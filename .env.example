# Set these to the account running the container (id -u and id -g).
BCFUNL_UID=1000
BCFUNL_GID=1000
# Preserve existing absolute paths because collection.sqlite3 stores payload paths.
BCFUNL_STAGING=/mnt/backup/bcfstag3
BCFUNL_MUSIC=/mnt/tankn4/F8NAS1/music
BCFUNL_COOKIES=./bandcamp.cookies.txt
# Optional override for a pinned commit tag or digest.
BCFUNL_IMAGE=ghcr.io/shunte88/bcfunl:latest

# Discogs personal access token for artist/title/country release enrichment.
# Leave empty for map-recognized source genres only, or run --process --offline.
DISCOGS_TOKEN=

# Required by the acquire/process entrypoint in the single-service Compose stack.
BCFUNL_COLLECTION=johnsmith
BCFUNL_TEMPLATE="{artist}/{album} [{country_iso}] [{catalog_num}]/{disc}-{track} - {title}"
