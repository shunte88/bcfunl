# Set these to the account running the container (id -u and id -g).
BCFUNL_UID=1000
BCFUNL_GID=1000
# Preserve existing absolute paths because collection.sqlite3 stores payload paths.
BCFUNL_STAGING=/mnt/backup/bcfstag3
BCFUNL_MUSIC=/mnt/tankn4/music
BCFUNL_COOKIES=./bandcamp.cookies.txt
BCFUNL_VCW_SOURCE=../vcw
# Optional published image; omit when building locally.
# BCFUNL_IMAGE=ghcr.io/your-account/bcfunl:latest
